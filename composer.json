{
  "name": "tinywan/rpc",
  "description": "simple rpc service for webman plugin",
  "keywords": ["webman", "rpc", "plugin", "json", "jsonrpc"],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Tinywan",
      "email": "756684177@qq.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "workerman/webman-framework": "^1.5||^2.0",
    "tinywan/exception-handler": "^1.5"
  },
  "autoload": {
    "psr-4": {
      "Tinywan\\Rpc\\": "src"
    },
    "files": [
      "src/function.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tinywan\\Rpc\\Tests\\": "tests"
    }
  },
  "require-dev": {
    "workerman/webman": "^1.0",
    "pestphp/pest": "^1.22",
    "mockery/mockery": "^1.4"
  },
  "scripts": {
    "format:check": "mago format --check",
    "format": "mago format",
    "lint": "mago lint",
    "analyse": "mago analyze",
    "test": "pest",
    "check": [
      "@format:check",
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
